generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Club {
  id        String   @id @default(cuid())
  nameRu    String
  nameEn    String?  @db.VarChar(255)
  city      String?  @db.VarChar(255)
  logoUrl   String?  @db.Text
  oneClubHidden Boolean @default(false)
  seasons   ClubSeason[]

  @@unique([nameRu])
}

model Season {
  id             String   @id @default(cuid())
  startYear      Int
  endYear        Int
  label          String   @db.VarChar(255)
  matchesPerTeam Int      @default(30)
  clubSeasons    ClubSeason[]

  @@unique([startYear, endYear])
}

model ClubSeason {
  id           String   @id @default(cuid())
  clubId       String
  seasonId     String
  sourceName   String?  @db.VarChar(255)
  position     Int?
  points       Int?
  played       Int?
  won          Int?
  drawn        Int?
  lost         Int?
  goalsFor     Int?
  goalsAgainst Int?

  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  players      PlayerSeason[]

  @@unique([clubId, seasonId])
  @@index([seasonId])
}

model Player {
  id          String   @id @default(cuid())
  lastName    String   @db.VarChar(255)
  firstName   String?  @db.VarChar(255)
  fullName    String   @db.VarChar(255)
  alias       String?  @db.VarChar(50)
  nationality String?  @db.VarChar(255)
  birthYear   Int?

  seasons     PlayerSeason[]

  @@index([fullName])
}

model PlayerSeason {
  id             String   @id @default(cuid())
  playerId       String
  clubSeasonId   String
  rating         Int
  primeRating    Int      @default(0)
  primeSeason    String?  @db.VarChar(50)
  mainPosition   String   @db.VarChar(50)
  otherPositions String?  @db.VarChar(255)
  age            Int?
  shirtNumber    Int?
  sourceName     String?  @db.VarChar(255)
  sourceUrl      String?  @db.Text
  sourcePosition String?  @db.VarChar(50)
  nationality    String?  @db.VarChar(255)
  matches        Int?
  goals          Int?
  assists        Int?

  player         Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clubSeason     ClubSeason @relation(fields: [clubSeasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, clubSeasonId])
  @@index([clubSeasonId])
  @@index([mainPosition])
}

model User {
  id               String   @id @default(cuid())
  provider         String   @default("guest") @db.VarChar(50)
  providerId       String   @unique @db.VarChar(255)
  telegramId       String?  @unique @db.VarChar(255) // Temporary legacy field for rollback compatibility
  username         String?  @db.VarChar(255)
  firstName        String?  @db.VarChar(255)
  lastName         String?  @db.VarChar(255)
  photoUrl         String?  @db.Text
  email            String?  @db.VarChar(255)
  displayName      String   @default("Игрок") @db.VarChar(255)
  profileStatsJson String?  @db.Text
  telegramNotificationsEnabled Boolean @default(true)
  telegramChatStarted Boolean @default(false)
  notifyNews Boolean @default(false)
  notifyInvites Boolean @default(true)
  notifyResults Boolean @default(true)
  notifyFriends Boolean @default(true)
  notifyFriendReplies Boolean @default(true)
  notificationsRevision Int @default(0)
  bannedAt DateTime?
  bannedUntil DateTime?
  banReason String? @db.Text
  notificationCadence String @default("weekly")
  deletionRequestedAt DateTime?
  deleteAfterAt DateTime?
  lastActiveAt DateTime?
  telegramWelcomeSentAt DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  referralCode     String?  @unique @db.VarChar(50)
  referredBy       String?  @db.VarChar(50)
  referralJoinedAt DateTime?
  referralCount    Int      @default(0)
  tokenBalance     Int      @default(0)
  avatarColor      String   @default("#00C896")
  statusEmoji      String   @default("🏆")
  selectedAvatar   String   @default("ball")
  profileStyle     String   @default("classic")
  tokenEntries     TokenEntry[]
  profileUnlocks   ProfileUnlock[]
  sentFriendships  Friendship[] @relation("FriendFrom")
  receivedFriendships Friendship[] @relation("FriendTo")

  runs             GameRun[]
  multiplayerSeats MultiplayerSeat[]
  @@index([username])
}

model AdminCredential {
  id                 String   @id @default(cuid())
  username           String   @unique @db.VarChar(100)
  role               String   @default("viewer") @db.VarChar(20)
  passwordHash       String   @db.VarChar(255)
  mustChangePassword Boolean  @default(true)
  sessionVersion     Int      @default(1)
  updatedAt          DateTime @updatedAt
}

model AppSetting {
  key   String @id @db.VarChar(100)
  value String @db.VarChar(255)
}

model AdminAccess {
  id         String   @id @default(cuid())
  telegramId String   @unique @db.VarChar(32)
  role       String   @default("admin") @db.VarChar(20)
  status     String   @default("pending") @db.VarChar(20)
  addedBy    String?  @db.VarChar(32)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AdminLoginChallenge {
  id         String   @id @default(cuid())
  telegramId String   @db.VarChar(32)
  codeHash   String   @db.VarChar(128)
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([telegramId, expiresAt])
}

model NotificationCampaign {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(120)
  message   String @db.Text
  cadence   String   @default("weekly") @db.VarChar(20)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  format String @default("text")
  imageId String?
  buttonText String @default("Play")
  buttonUrl String @db.Text @default("https://t.me/RPL30_bot?startapp")
  scheduledAt DateTime?
  archivedAt DateTime?

}

model NotificationDispatch {
  id          String   @id @default(cuid())
  campaignKey String   @db.VarChar(160)
  userId      String   @db.VarChar(191)
  sentAt      DateTime @default(now())
  @@unique([campaignKey, userId])
  @@index([sentAt])
}

model GameRun {
  completedAt DateTime?
  id           String   @id @default(cuid())
  formation    String   @default("4-3-3") @db.VarChar(20)
  difficulty   String   @default("normal") @db.VarChar(20)
  draftMode    String   @default("squad_first") @db.VarChar(30)
  gameMode     String @default("classic")
  challengeIssueId String? @db.VarChar(80)
  ratingMode   String   @default("season") @db.VarChar(20)
  eraFilter    String   @default("all") @db.VarChar(20)
  rerollsTotal Int      @default(1)
  rerollsUsed  Int      @default(0)

  completed    Boolean  @default(false)
  wins         Int?
  draws        Int?
  losses       Int?
  points       Int?
  position     Int?
  goalsFor     Int?
  goalsAgainst Int?
  overallRating Int?

  managerName   String?  @db.VarChar(255)
  managerRating Int?
  teamName      String?  @db.VarChar(255)

  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())

  eraStartYear   Int      @default(2000)
  eraEndYear     Int      @default(2025)
  clubFilter     String?  @db.VarChar(255)
  nationalityFilter String? @db.VarChar(255)

  slots        GameSlot[]
  multiplayerSeat MultiplayerSeat?
  tokenEntry TokenEntry?

  @@index([userId])
  @@index([completed])
  @@index([completed, points])
  @@index([createdAt])
  @@index([challengeIssueId])
}

model GameSlot {
  id                   String   @id @default(cuid())
  runId                String
  slotPosition         String   @db.VarChar(20)
  playerSeasonId       String?
  playerSeasonYear     Int?
  playerName           String?  @db.VarChar(255)
  playerLastName       String?  @db.VarChar(255)
  playerRating         Int?
  playerPrimeRating    Int?
  playerPosition       String?  @db.VarChar(50)
  playerOtherPositions String?  @db.VarChar(255)
  playerNationality    String?  @db.VarChar(255)
  isCompatible         Boolean  @default(true)

  run                  GameRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, slotPosition])
  @@index([runId])
  @@index([playerSeasonId])
}

model MultiplayerRoom {
  code         String   @id
  hostUserId   String
  status       String   @default("lobby")
  draftStartAt DateTime?
  maxPlayers   Int      @default(2)
  seatCount    Int      @default(1)
  ratingMode   String   @default("season")
  draftMode    String   @default("squad_first")
  showRatings  Boolean  @default(true)
  eraFilter    String   @default("all")
  eraStartYear Int      @default(2010)
  eraEndYear   Int      @default(2021)
  withManager  Boolean  @default(false)
  resultJson   String?  @db.LongText
  seriesTargetWins Int @default(0)
  seriesRound Int @default(1)
  seriesRootCode String?
  seriesScoreJson String? @db.LongText
  seriesWinnerKey String?
  nextRoomCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  seats        MultiplayerSeat[]
}

model MultiplayerSeat {
  id        String   @id @default(cuid())
  roomCode  String
  userId    String?
  isBot     Boolean  @default(false)
  forfeited Boolean  @default(false)
  name      String
  formation String   @default("4-3-3")
  ready     Boolean  @default(false)
  pickDeadline DateTime?
  pendingSpinJson String? @db.LongText
  seriesMemberKey String?
  resultViewedAt DateTime?
  managerName String?
  managerRating Int?
  runId     String?  @unique
  joinedAt  DateTime @default(now())
  room      MultiplayerRoom @relation(fields: [roomCode], references: [code], onDelete: Cascade)
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  run       GameRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([roomCode, userId])
  @@index([roomCode])
}


// One reward per completed run. Purchases are separate negative entries.
model TokenEntry {
  id        String   @id @default(cuid())
  userId    String
  runId     String?  @unique
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run       GameRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model ProfileUnlock {
  id        String   @id @default(cuid())
  userId    String
  key        String   @db.VarChar(80)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}

model MultiplayerInvite {
  id String @id @default(cuid())
  roomCode String
  fromId String
  toId String
  status String @default("pending")
  createdAt DateTime @default(now())
  @@unique([roomCode, toId])
  @@index([toId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())
  status    String @default("accepted")
  from      User     @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)
  @@unique([fromId, toId])
  @@index([toId])
}

model TelegramOutbox {
  id String @id @default(cuid())
  eventKey String @unique
  userId String
  text String @db.Text
  startParam String
  attempts Int @default(0)
  availableAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([sentAt, availableAt])
  category String @default("friends")
  imageId String?
  campaignId String?
  status String @default("pending")
  buttonText String @default("Open 30-0")
  buttonUrl String?
  lastError String?
  @@index([campaignId, status])

}

model MediaAsset {
  id String @id @default(cuid())
  mime String
  data Bytes @db.LongBlob
  createdBy String
  createdAt DateTime @default(now())
}
model CampaignJob {
  id String @id
  campaignId String
  payloadJson String @db.LongText
  cursor String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([completedAt])
}
model ModerationAction {
  id String @id @default(cuid())
  userId String
  actor String
  action String
  reason String @db.Text
  until DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
