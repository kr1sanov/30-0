generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Club {
  id      String       @id @default(cuid())
  nameRu  String
  nameEn  String?
  city    String?
  logoUrl String?
  oneClubHidden Boolean @default(false)
  oneClubShown Boolean @default(false)
  seasons ClubSeason[]

  @@unique([nameRu])
}

model Season {
  id             String       @id @default(cuid())
  startYear      Int
  endYear        Int
  label          String
  matchesPerTeam Int          @default(30)
  clubSeasons    ClubSeason[]

  @@unique([startYear, endYear])
}

model ClubSeason {
  id           String  @id @default(cuid())
  clubId       String
  seasonId     String
  sourceName   String?
  position     Int?
  points       Int?
  played       Int?
  won          Int?
  drawn        Int?
  lost         Int?
  goalsFor     Int?
  goalsAgainst Int?

  club    Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season  Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  players PlayerSeason[]

  @@unique([clubId, seasonId])
  @@index([seasonId])
}

model Player {
  id          String  @id @default(cuid())
  lastName    String
  firstNameRu String?
  lastNameRu  String?
  aliasRu     String?
  mergedIntoId String?
  firstName   String?
  fullName    String
  alias       String?
  nationality String?
  birthYear   Int?

  seasons PlayerSeason[]

  @@index([fullName])
}

model PlayerSeason {
  id             String  @id @default(cuid())
  playerId       String
  clubSeasonId   String
  rating         Int
  primeRating    Int     @default(0)
  primeSeason    String?
  mainPosition   String
  otherPositions String?
  age            Int?
  shirtNumber    Int?
  sourceName     String?
  sourceUrl      String?
  sourcePosition String?
  nationality    String?
  matches        Int?
  goals          Int?
  assists        Int?

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clubSeason ClubSeason @relation(fields: [clubSeasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, clubSeasonId])
  @@index([clubSeasonId])
  @@index([mainPosition])
}

model User {
  id                           String    @id @default(cuid())
  provider                     String    @default("guest")
  providerId                   String    @unique
  username                     String?
  firstName                    String?
  lastName                     String?
  photoUrl                     String?
  email                        String?
  displayName                  String    @default("Игрок")
  profileStatsJson             String?
  telegramNotificationsEnabled Boolean   @default(true)
  telegramChatStarted          Boolean   @default(false)
  notifyNews Boolean @default(false)
  notifyInvites Boolean @default(true)
  notifyResults Boolean @default(true)
  notifyFriends Boolean @default(true)
  notifyFriendReplies Boolean @default(true)
  notificationsRevision Int @default(0)
  botLanguage String @default("ru")
  pendingNotificationPatch String?
  moderationStatus String @default("active")
  bannedAt DateTime?
  bannedUntil DateTime?
  banReason String?
  notificationCadence          String    @default("weekly")
  deletionRequestedAt          DateTime?
  deleteAfterAt                DateTime?
  lastActiveAt                 DateTime?
  telegramWelcomeSentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralCode  String? @unique
  referredBy    String?
  referralJoinedAt DateTime?
  referralCount Int     @default(0)
  tokenBalance Int @default(0)
  avatarColor String @default("#00C896")
  statusEmoji String @default("🏆")
  selectedAvatar String @default("ball")
  profileStyle String @default("classic")
  tokenEntries TokenEntry[]
  profileUnlocks ProfileUnlock[]
  sentFriendships Friendship[] @relation("FriendFrom")
  receivedFriendships Friendship[] @relation("FriendTo")

  runs             GameRun[]
  multiplayerSeats MultiplayerSeat[]
  @@index([username])
}

model AdminCredential {
  id                 String   @id @default(cuid())
  username           String   @unique
  role               String   @default("viewer")
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  sessionVersion     Int      @default(1)
  updatedAt          DateTime @updatedAt
}

model AppSetting {
  key   String @id
  value String
}

model AdminAccess {
  id         String   @id @default(cuid())
  telegramId String   @unique
  role       String   @default("admin")
  status     String   @default("pending")
  addedBy    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AdminLoginChallenge {
  id         String    @id @default(cuid())
  telegramId String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([telegramId, expiresAt])
}

model NotificationCampaign {
  id        String   @id @default(cuid())
  title     String
  titleEn   String?
  messageEn String?
  buttonTextEn String?
  message   String
  cadence   String   @default("weekly")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  format String @default("text")
  imageId String?
  buttonText String @default("Play")
  buttonUrl String @default("https://t.me/RPL30_bot?startapp")
  scheduledAt DateTime?
  archivedAt DateTime?

}

model NotificationDispatch {
  id          String   @id @default(cuid())
  campaignKey String
  userId      String
  sentAt      DateTime @default(now())

  @@unique([campaignKey, userId])
  @@index([sentAt])
}

model GameRun {
  opponentSeasonYear Int?
  seasonResultJson String?
  multiplayerRoomCode String?
  multiplayerRound Int?
  id           String @id @default(cuid())
  formation    String @default("4-3-3")
  difficulty   String @default("normal")
  draftMode    String @default("squad_first")
  gameMode     String @default("classic")
  challengeIssueId String?
  ratingMode   String @default("season")
  eraFilter    String @default("all")
  rerollsTotal Int    @default(1)
  rerollsUsed  Int    @default(0)

  completedAt DateTime?
  completed     Boolean @default(false)
  wins          Int?
  draws         Int?
  losses        Int?
  points        Int?
  position      Int?
  goalsFor      Int?
  goalsAgainst  Int?
  overallRating Int?

  managerName   String?
  managerRating Int?
  teamName      String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  eraStartYear      Int     @default(2000)
  eraEndYear        Int     @default(2025)
  clubFilter        String?
  nationalityFilter String?

  slots           GameSlot[]
  multiplayerSeat MultiplayerSeat?
  tokenEntry TokenEntry?

  @@index([userId])
  @@index([completed])
  @@index([completed, points])
  @@index([createdAt])
  @@index([challengeIssueId])
}

model GameSlot {
  id                   String  @id @default(cuid())
  runId                String
  slotPosition         String
  playerSeasonId       String?
  playerSeasonYear     Int?
  playerName           String?
  playerLastName       String?
  playerRating         Int?
  playerPrimeRating    Int?
  playerPosition       String?
  playerOtherPositions String?
  playerNationality    String?
  isCompatible         Boolean @default(true)

  run GameRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, slotPosition])
  @@index([runId])
  @@index([playerSeasonId])
}

model MultiplayerRoom {
  roundsJson String?
  code         String            @id
  hostUserId   String
  status       String            @default("lobby")
  draftStartAt DateTime?
  maxPlayers   Int               @default(2)
  seatCount    Int               @default(1)
  ratingMode   String            @default("season")
  draftMode    String            @default("squad_first")
  showRatings  Boolean           @default(true)
  eraFilter    String            @default("all")
  eraStartYear Int               @default(2010)
  eraEndYear   Int               @default(2021)
  withManager  Boolean           @default(false)
  resultJson   String?
  seriesTargetWins Int @default(0)
  seriesRound Int @default(1)
  seriesRootCode String?
  seriesScoreJson String?
  seriesWinnerKey String?
  nextRoomCode String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  seats        MultiplayerSeat[]
}

model MultiplayerSeat {
  lastSeenAt DateTime?
  id        String          @id @default(cuid())
  roomCode  String
  userId    String?
  isBot     Boolean         @default(false)
  forfeited Boolean        @default(false)
  name      String
  formation String          @default("4-3-3")
  ready     Boolean         @default(false)
  pickDeadline DateTime?
  pendingSpinJson String?
  seriesMemberKey String?
  resultViewedAt DateTime?
  managerName String?
  managerRating Int?
  runId     String?         @unique
  joinedAt  DateTime        @default(now())
  room      MultiplayerRoom @relation(fields: [roomCode], references: [code], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  run       GameRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([roomCode, userId])
  @@index([roomCode])
}


// One reward per completed run. Purchases are separate negative entries.
model TokenEntry {
  id        String   @id @default(cuid())
  userId    String
  runId     String?  @unique
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run       GameRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model ProfileUnlock {
  id        String   @id @default(cuid())
  userId    String
  key        String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
}

model MultiplayerInvite {
  id String @id @default(cuid())
  roomCode String
  fromId String
  toId String
  status String @default("pending")
  createdAt DateTime @default(now())
  @@unique([roomCode, toId])
  @@index([toId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())
  status    String @default("accepted")
  from      User     @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)
  @@unique([fromId, toId])
  @@index([toId])
}

model TelegramOutbox {
  id String @id @default(cuid())
  eventKey String @unique
  userId String
  text String
  textEn String?
  buttonTextEn String?
  startParam String
  attempts Int @default(0)
  availableAt DateTime @default(now())
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([sentAt, availableAt])
  category String @default("friends")
  imageId String?
  campaignId String?
  status String @default("pending")
  buttonText String @default("Open 30-0")
  buttonUrl String?
  lastError String?
  @@index([campaignId, status])

}

model MediaAsset {
  id String @id @default(cuid())
  mime String
  data Bytes
  createdBy String
  createdAt DateTime @default(now())
}
model CampaignJob {
  id String @id
  campaignId String
  payloadJson String
  cursor String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([completedAt])
}
model ModerationAction {
  id String @id @default(cuid())
  userId String
  actor String
  action String
  reason String
  until DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
